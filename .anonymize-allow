# Documentation examples that legitimately resemble real values.
# One extended-regex per line. Justify every entry.

# RFC 5737 / RFC 6890 documentation address ranges — safe by definition, used in examples.
192\.0\.2\.[0-9]{1,3}
198\.51\.100\.[0-9]{1,3}
203\.0\.113\.[0-9]{1,3}

# RFC 2606 reserved example domains.
[a-z0-9-]+@example\.(com|org|net)
example\.(com|org|net)

# home.arpa is the RFC 8375 reserved name for home networks; it is the documented
# default value for <CLUSTER_DOMAIN>, not anyone's real domain.
home\.arpa

# The placeholder convention itself must never trip a pattern.
<[A-Z0-9_]+>

# systemd templated unit instances are written unit@instance.service, which is the
# same shape as an email address. These are fixed upstream unit names, not addresses.
[a-z0-9-]+@[a-z0-9-]+\.(service|socket|timer|mount|swap|target|path|slice)

# This repo's own gitignored denylist filename ends in .local and is not a hostname.
anonymize-denylist\.local

# svc.cluster.local is the Kubernetes-internal DNS suffix — a fixed constant of the
# platform, identical on every cluster, and unavoidable when documenting DNS behaviour.
# Matches the service-FQDN form only; a bare hostname ending .local still trips.
[a-z0-9.-]*\bsvc\.cluster\.local
